<Application
    x:Class="OpenReplay.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenReplay"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#76B900" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8BD400" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4D7900" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#8BD400" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#101900" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
